#!/usr/bin/env bash
# If latest.json changes in the commits being pushed, deploy Pages first.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
DEPLOY="$ROOT/scripts/deploy_pages.sh"
zero=0000000000000000000000000000000000000000
changed=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ -z "${local_sha:-}" ]] && continue
  [[ "$local_sha" == "$zero" ]] && continue

  if [[ "$remote_sha" == "$zero" ]]; then
    # New remote branch: any commit in the push that touches latest.json
    if git log --pretty=format: --name-only "$local_sha" --not --remotes 2>/dev/null | grep -qx 'latest.json'; then
      changed=1
    elif git diff-tree --no-commit-id --name-only -r "$local_sha" | grep -qx 'latest.json'; then
      changed=1
    fi
  else
    if git diff --name-only "$remote_sha" "$local_sha" | grep -qx 'latest.json'; then
      changed=1
    fi
  fi
done

if [[ "$changed" -eq 0 ]]; then
  exit 0
fi

echo "pre-push: latest.json changed — running scripts/deploy_pages.sh"
if [[ ! -f "$DEPLOY" ]]; then
  echo "pre-push: missing $DEPLOY" >&2
  exit 1
fi
chmod +x "$DEPLOY" 2>/dev/null || true
"$DEPLOY"
