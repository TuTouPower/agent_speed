# Cloudflare Pages deploy (local only — never commit real .env)
# Prefer a scoped API Token with Pages edit on this account/project:
CLOUDFLARE_API_TOKEN=

# Or Global API Key + email (works, but broader privilege):
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_EMAIL=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=agent-speed
